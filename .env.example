# 服务端私密模型配置。
# 这些值只应由项目维护者在部署环境中设置，绝不要放进前端、截图或公开仓库。
OPENAI_API_KEY=your_server_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-turbo

# 默认禁止 HTTP 与内网模型地址。仅在完全可信的本地开发环境中开启。
ALLOW_INSECURE_LLM_HTTP=false

# 强烈建议生产环境限制服务端允许访问的模型域名，逗号分隔。
LLM_ALLOWED_HOSTS=dashscope.aliyuncs.com
