# 平台共享 API 配置。
# 这些值只应由项目维护者在部署环境中设置，绝不要放进前端、截图或公开仓库。
PLATFORM_API_ENABLED=true
OPENAI_API_KEY=your_server_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash

# 百炼共享模型默认关闭深度思考，以缩短首字响应时间。
# 如确实需要更强推理，可在部署环境显式改为 true。
LLM_ENABLE_THINKING=false

# 默认禁止 HTTP 与内网模型地址。仅在完全可信的本地开发环境中开启。
ALLOW_INSECURE_LLM_HTTP=false

# 只限制平台共享 API 的出站域名，逗号分隔。
# 个人 BYOK 另有 HTTPS、内网地址和生产可信域名检查。
LLM_ALLOWED_HOSTS=dashscope.aliyuncs.com
# 仅在服务端填写审核过的其他 BYOK 主机名。
BYOK_ALLOWED_HOSTS=
